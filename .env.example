# Copy to .env for local settings. Never put credentials in tracked files.
APP_TARGET=storefront
# Optional URL override for ad-hoc runs. Ticket runs (qa:run) use the servers saved in
# the ticket's ticket.json and refuse a BASE_URL that differs. Only dev hosts are accepted.
# BASE_URL=https://dev-static-9.musticker.com/
# STOREFRONT_URL= ADMIN_URL= API_URL= override one app each.
# Optional exact tested application build or commit identifier.
# APP_BUILD=

# Dev-server member for member-only specs (e.g. GLOP-2044 review rewards). Falls back to AUTH_TEST_EMAIL/PASSWORD.
QA_MEMBER_EMAIL=
QA_MEMBER_PASSWORD=
# Optional dev WAF key sent as x-internal-origin to shared-dev-static-* hosts only. Falls back to DEV_INTERNAL_ORIGIN_KEY.
QA_DEV_ORIGIN_KEY=

{
  "name": "musticker-qa-workspace",
  "version": "1.0.0",
  "private": true,
  "description": "Shared QA agents, ticket evidence, knowledge, and a fresh Playwright suite for Musticker.",
  "type": "module",
  "engines": { "node": ">=22" },
  "scripts": {
    "test": "playwright test --project=chromium",
    "test:all": "playwright test",
    "test:admin": "node scripts/run-target.mjs admin",
    "test:storefront": "node scripts/run-target.mjs storefront",
    "test:demo": "playwright test --config=playwright.demo.config.ts",
    "test:ui": "playwright test --ui",
    "test:headed": "playwright test --project=chromium --headed",
    "test:list": "playwright test --list",
    "report": "playwright show-report artifacts/latest/html",
    "typecheck": "tsc --noEmit",
    "check": "npm run agents:check && npm run typecheck && npm run test:workspace",
    "test:workspace": "node --test scripts/tests/*.test.mjs",
    "qa:new": "node scripts/new-ticket.mjs",
    "qa:run": "node scripts/run-ticket.mjs",
    "qa:env": "node scripts/ticket-env.mjs",
    "agents:sync": "node scripts/sync-agents.mjs",
    "agents:check": "node scripts/sync-agents.mjs --check",
    "browsers:install": "playwright install chromium firefox webkit"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "^24.0.0",
    "dotenv": "^17.0.0",
    "typescript": "^5.9.0"
  }
}
